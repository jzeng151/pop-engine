# apps/web — copy to .env.local for local dev.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# F-701 authentication foundation. The publishable key is intended for browser use; never put a
# service-role or secret key in a NEXT_PUBLIC_* variable.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<placeholder>
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Legacy projects may use this instead of NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<legacy-anon-key-placeholder>

# Optional. Share links on /events/:id/promote default to the browser origin;
# set this only when the copied URL must differ from the page the organizer is on.
# NEXT_PUBLIC_WEB_ORIGIN=https://demo.example.com
