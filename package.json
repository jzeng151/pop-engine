{
  "name": "pop-engine",
  "private": true,
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck && tsc -p docs/proposals/tsconfig.json",
    "lint": "eslint .",
    "build": "pnpm --filter web build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:baseline": "node scripts/check-baseline-drift.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --exclude '**/node_modules/**'",
    "test:cofiring": "vitest run --root . --config scripts/dedupe-cofiring/vitest.config.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^3.0.5",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^3.0.5"
  }
}
